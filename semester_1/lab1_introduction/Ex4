#include <iostream>

int main() {
	int n;
std::cout << "Enter n: ";
	std::cin >> n;
	int a = n / 100000;
	int b = n % 100000 / 10000;
	int c = n % 10000 / 1000;
	int d = n % 1000 / 100;
	int e = n % 100 / 10;
	int f = n % 10;
	int sumabc = a + b + c;
	int sumdef = d + e + f;
	if (sumabc == sumdef) {
	std::cout << "YES";
	}
	else
	{
	std::cout << "NO";
	}


	return 0;
}
